all:
  children:
    masters:
      hosts:
%{ for idx in master.index ~}
        ${master.vm_name[idx]}:
          ansible_host: ${master.ip_address[idx]}
          ansible_user: ${master.user}
%{ endfor ~}
    workers:
      hosts:
%{ for idx in worker.index ~}
        ${worker.vm_name[idx]}:
          ansible_host: ${worker.ip_address[idx]}
          ansible_user: ${worker.user}
%{ endfor ~}
    k8s_cluster:
      children:
        masters:
        workers:
      vars:
        ansible_ssh_common_args: '-o StrictHostKeyChecking=no'
        ansible_ssh_private_key_file: ${ssh_private_key}
        ansible_python_interpreter: /usr/bin/python3